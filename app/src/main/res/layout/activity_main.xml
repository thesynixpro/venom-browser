<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp">
        <TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center"
            android:text="A" android:textStyle="bold" android:textSize="21sp" android:textColor="#0B0D12"
            android:background="@drawable/logo_background" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="11dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aprax"
                android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="17sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BROWSER"
                android:textColor="@color/text_secondary" android:textSize="9sp" android:letterSpacing="0.18" />
        </LinearLayout>
        <TextView android:id="@+id/tabsButton" android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:text="1" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:background="@drawable/icon_button_background" />
        <TextView android:id="@+id/menuButton" android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:text="⋮" android:textSize="24sp" android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp" android:layout_marginTop="2dp" android:layout_marginBottom="8dp"
        android:gravity="center_vertical" android:paddingStart="13dp" android:paddingEnd="7dp"
        android:background="@drawable/address_background">
        <TextView android:id="@+id/securityIcon" android:layout_width="24dp" android:layout_height="wrap_content"
            android:gravity="center" android:text="⌕" android:textColor="@color/accent" android:textSize="21sp" />
        <EditText android:id="@+id/addressBar" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:singleLine="true" android:imeOptions="actionGo"
            android:inputType="textUri" android:hint="Search or enter address" android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" android:textSize="14sp" android:background="@android:color/transparent"
            android:paddingStart="7dp" android:paddingEnd="5dp" />
        <TextView android:id="@+id/goButton" android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:text="→" android:textSize="23sp" android:textStyle="bold"
            android:textColor="#0B0D12" android:background="@drawable/go_background" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent" />
        <LinearLayout android:id="@+id/homeView" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="35dp"
            android:background="@color/background">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR WEB,\nYOUR WAY."
                android:textColor="@color/text_primary" android:textSize="31sp" android:textStyle="bold" android:lineSpacingExtra="2dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="A calmer place to explore the internet." android:textSize="14sp" android:textColor="@color/text_secondary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="38dp"
                android:text="QUICK ACCESS" android:textColor="@color/text_secondary" android:textSize="10sp" android:letterSpacing="0.16" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:layout_marginTop="15dp">
                <TextView android:id="@+id/shortcutGoogle" android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1"
                    android:gravity="center" android:text="G\nGoogle" android:textSize="15sp" android:textColor="@color/text_primary"
                    android:background="@drawable/shortcut_background" />
                <TextView android:id="@+id/shortcutYouTube" android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:gravity="center" android:text="▶\nYouTube" android:textSize="15sp"
                    android:textColor="@color/text_primary" android:background="@drawable/shortcut_background" />
                <TextView android:id="@+id/shortcutGitHub" android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:gravity="center" android:text="⌘\nGitHub" android:textSize="15sp"
                    android:textColor="@color/text_primary" android:background="@drawable/shortcut_background" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:padding="16dp" android:text="TIP   Type a website or search term in the address bar above."
                android:textColor="@color/text_secondary" android:textSize="12sp" android:background="@drawable/tip_background" />
        </LinearLayout>
    </FrameLayout>

    <ProgressBar android:id="@+id/loadingProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp" android:visibility="gone"
        android:indeterminate="true" android:progressTint="@color/accent" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center"
        android:orientation="horizontal" android:background="@color/background" android:paddingStart="18dp" android:paddingEnd="18dp">
        <TextView android:id="@+id/backButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:gravity="center" android:text="‹" android:textSize="31sp" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/forwardButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:gravity="center" android:text="›" android:textSize="31sp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/homeButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:gravity="center" android:text="⌂" android:textSize="25sp" android:textColor="@color/accent" />
        <TextView android:id="@+id/reloadButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:gravity="center" android:text="↻" android:textSize="25sp" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/bookmarkButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:gravity="center" android:text="☆" android:textSize="25sp" android:textColor="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
